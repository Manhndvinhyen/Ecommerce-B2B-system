 *   Điền các giá trị thực tế vào env.php
 *
 * KHÔNG commit env.php lên git (đã gitignore)
 */
return [
    'backend' => ['frontName' => 'admin'],
    'crypt' => [
        // openssl rand -base64 32
        'key' => 'CHANGE_THIS_CRYPT_KEY'
    ],
    'db' => [
        'table_prefix' => '',
        'connection' => [
            'default' => [
                // Local Docker: 'db' | Cloud SQL: IP nội bộ
                'host'           => getenv('DB_HOST')     ?: 'db',
                'dbname'         => getenv('DB_NAME')     ?: 'magento',
                'username'       => getenv('DB_USER')     ?: 'magento',
                'password'       => getenv('DB_PASSWORD') ?: 'magento',
                'model'          => 'mysql4',
                'engine'         => 'innodb',
                'initStatements' => 'SET NAMES utf8;',
                'active'         => '1',
                'driver_options' => [1014 => false]
            ]
        ]
    ],
    'resource' => ['default_setup' => ['connection' => 'default']],
    'x-frame-options' => 'SAMEORIGIN',
    'MAGE_MODE' => 'default',
    'session' => ['save' => 'files'],
    'cache_types' => [
        'config' => 1, 'layout' => 1, 'block_html' => 1,
        'collections' => 1, 'reflection' => 1, 'db_ddl' => 1,
        'compiled_config' => 1, 'eav' => 1, 'full_page' => 1,
        'translate' => 1
    ],
    // =========================================================
    // Chatbot: đặt GEMINI_API_KEY trong env/custom.env (local)
    // hoặc GCP Secret Manager (production)
    // =========================================================
    'tmdt_chatbot' => [
        'gemini' => [
            'api_key' => getenv('GEMINI_API_KEY') ?: ''
        ]
    ]
];
