<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Order Management Routes -->
    <route url="/V1/tmdt-orders/create" method="POST">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="createOrder"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/tmdt-orders/status/:orderCode" method="GET">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="getOrderStatus"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/tmdt-orders/warehouses" method="GET">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="getWarehouses"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/tmdt-orders/confirm-payment" method="POST">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="confirmDirectPayment"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/tmdt-orders/update-fulfillment" method="POST">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="updateOrderFulfillment"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/tmdt-orders/confirm-receipt" method="POST">
        <service class="Tmdt\Order\Api\OrderManagementInterface" method="confirmReceiptByCustomer"/>
        <resources><resource ref="self"/></resources>
    </route>
</routes>
