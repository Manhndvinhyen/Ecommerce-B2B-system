<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="tmdt_wishlist_list" resource="default" engine="innodb" comment="Tmdt Wishlist Lists">
        <column xsi:type="int" name="list_id" padding="10" unsigned="true" nullable="false" identity="true" comment="List ID" />
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID" />
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="List Name" />
        <column xsi:type="timestamp" name="created_at" default="CURRENT_TIMESTAMP" nullable="false" comment="Created At" />
        <column xsi:type="timestamp" name="updated_at" default="CURRENT_TIMESTAMP" nullable="false" on_update="true" comment="Updated At" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="list_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_WISHLIST_LIST_CUSTOMER_FK" table="tmdt_wishlist_list" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE" />
        <index referenceId="TMDT_WISHLIST_LIST_CUSTOMER_IDX">
            <column name="customer_id" />
        </index>
    </table>
    <table name="tmdt_wishlist_item" resource="default" engine="innodb" comment="Tmdt Wishlist Items">
        <column xsi:type="int" name="item_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Item ID" />
        <column xsi:type="int" name="list_id" padding="10" unsigned="true" nullable="false" comment="List ID" />
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="SKU" />
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Product Name" />
        <column xsi:type="decimal" name="price" nullable="false" precision="12" scale="4" comment="Price" />
        <column xsi:type="varchar" name="unit" nullable="false" length="32" comment="Unit" />
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Image" />
        <column xsi:type="varchar" name="category" nullable="true" length="255" comment="Category" />
        <column xsi:type="timestamp" name="created_at" default="CURRENT_TIMESTAMP" nullable="false" comment="Created At" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_WISHLIST_ITEM_LIST_FK" table="tmdt_wishlist_item" column="list_id" referenceTable="tmdt_wishlist_list" referenceColumn="list_id" onDelete="CASCADE" />
        <index referenceId="TMDT_WISHLIST_ITEM_LIST_IDX">
            <column name="list_id" />
        </index>
        <index referenceId="TMDT_WISHLIST_ITEM_SKU_IDX">
            <column name="sku" />
        </index>
    </table>
</schema>
