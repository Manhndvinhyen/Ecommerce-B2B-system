#!/usr/bin/env bash
# Build React frontend and serve via nginx at magento.test/

echo "🚀 Bắt đầu build React App..."

cd src/react-frontend || { echo "❌ Không tìm thấy thư mục src/react-frontend"; exit 1; }

echo "📦 Cài đặt thư viện NPM..."
npm install

if [ ! -f ".env" ]; then
    echo "⚠️ Không tìm thấy file .env, đang tự động tạo từ .env.example..."
    cp .env.example .env
fi

echo "🛠️ Build ứng dụng React..."
npm run build
# Vite tự build thẳng vào ../pub/react/ (cấu hình trong vite.config.ts)

echo "✅ Build xong: src/pub/react/"

echo "🔄 Reload nginx..."
cd ../../
NGINX_CONTAINER=$(docker ps --filter "label=com.docker.compose.service=app" --format "{{.ID}}" | head -1)
if [ -n "$NGINX_CONTAINER" ]; then
  docker exec "$NGINX_CONTAINER" nginx -s reload
else
  echo "⚠️ Nginx container not found, skipping reload"
fi

echo "✅ Hoàn tất! Truy cập https://magento.test để xem React app."
