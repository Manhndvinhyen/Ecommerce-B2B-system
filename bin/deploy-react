#!/usr/bin/env bash
set -euo pipefail

# Build + sync React frontend to Magento + refresh cache.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FRONTEND_DIR="$ROOT_DIR/src/react-frontend"
LIVE_DOMAIN="${LIVE_DOMAIN:-https://organica.click}"

echo "🚀 Bắt đầu deploy React frontend..."
echo "📁 Root: $ROOT_DIR"

cd "$FRONTEND_DIR"

echo "📦 Cài đặt thư viện NPM..."
if [ -f "package-lock.json" ]; then
  npm ci --no-audit --no-fund
else
  npm install --no-audit --no-fund
fi

if [ ! -f ".env" ] && [ -f ".env.example" ]; then
  echo "⚠️ Không tìm thấy .env, đang tạo từ .env.example..."
  cp .env.example .env
fi

echo "🛠️ Build ứng dụng React..."
npm run build

echo "🔁 Đồng bộ build vào Magento theme (react-home)..."
node scripts/magento-sync.mjs

LOCAL_SCRIPT=$(sed -n 's/.*src="\(\/react\/assets\/index-[^"]*\.js\)".*/\1/p' "$ROOT_DIR/src/pub/react/index.html" | head -1)
echo "   - Local bundle: ${LOCAL_SCRIPT:-N/A}"

cd "$ROOT_DIR"

echo "🧹 Làm mới cache Magento (layout/full page)..."
if ./bin/magento cache:clean layout block_html full_page config; then
  ./bin/magento cache:flush
else
  echo "⚠️ Không clear được cache qua ./bin/magento (kiểm tra Docker service)."
fi

echo "🔄 Reload nginx trong container (nếu có)..."
if command -v docker >/dev/null 2>&1; then
  NGINX_CONTAINER=$(docker ps --filter "label=com.docker.compose.service=app" --format "{{.ID}}" | head -1 || true)
  if [ -n "${NGINX_CONTAINER:-}" ]; then
    docker exec "$NGINX_CONTAINER" nginx -s reload || true
  else
    echo "⚠️ Không tìm thấy container service=app để reload nginx."
  fi
fi

echo "🔎 Verify nhanh trạng thái live: $LIVE_DOMAIN"
if command -v curl >/dev/null 2>&1; then
  LIVE_SCRIPT=$(curl -L -s "$LIVE_DOMAIN/" 2>/dev/null | sed -n 's/.*src="\(\/react\/assets\/index-[^"]*\.js\)".*/\1/p' | head -1)
  echo "   - Live bundle: ${LIVE_SCRIPT:-N/A}"

  if curl -L -s "$LIVE_DOMAIN/checkout/cart" | grep -q "view=cart"; then
    echo "   - Cart route override: OK (/checkout/cart -> /react/index.html?view=cart)"
  else
    echo "   - Cart route override: CHƯA THẤY"
  fi

  if [ -n "${LOCAL_SCRIPT:-}" ] && [ -n "${LIVE_SCRIPT:-}" ] && [ "$LOCAL_SCRIPT" != "$LIVE_SCRIPT" ]; then
    echo "❌ Live vẫn đang dùng bundle cũ."
    echo "   Local: $LOCAL_SCRIPT"
    echo "   Live : $LIVE_SCRIPT"
    echo "   -> Hãy deploy trên đúng production server hoặc purge CDN (Cloudflare) cho /react/*"
    exit 2
  fi
fi

echo "✅ Hoàn tất deploy React cho $LIVE_DOMAIN"
