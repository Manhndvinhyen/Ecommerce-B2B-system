<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tmdt-recurring/subscribe" method="POST">
        <service class="Tmdt\Recurring\Api\RecurringInterface" method="subscribe"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/tmdt-recurring/list" method="GET">
        <service class="Tmdt\Recurring\Api\RecurringInterface" method="listSubscriptions"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
    <route url="/V1/tmdt-recurring/cancel" method="POST">
        <service class="Tmdt\Recurring\Api\RecurringInterface" method="cancelSubscription"/>
        <resources><resource ref="anonymous"/></resources>
    </route>
</routes>
