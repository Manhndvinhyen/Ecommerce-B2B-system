# SSL / Certificates (machine-local, regenerated per device)
rootCA.pem
nginx.key
nginx.crt

# Database dumps (use bin/db-dump / bin/db-import to share)
# dump/*.sql
# dump/*.sql.gz

# Custom secrets (per-developer, never committed)
env/custom.env
env/magento.env
magento.env

# Magento env.php — chứa DB credentials, session key, API keys
# Không bao giờ commit. Dùng src/app/etc/env.php.sample làm template.
src/app/etc/env.php

# OS / Editor
.DS_Store
Thumbs.db
.idea/

# Claude Code local settings (machine-specific)
.claude/

# React build artifacts (generated by bin/deploy-react, không commit)
src/pub/react/

# Product media — generated by Magento/Docker, never commit
src/pub/media/catalog/
