<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tmdt-search/purchase-history" method="GET">
        <service class="Tmdt\Search\Api\PurchaseHistoryInterface" method="get" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
    <route url="/V1/tmdt-search/purchase-history" method="POST">
        <service class="Tmdt\Search\Api\PurchaseHistoryInterface" method="save" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
    <route url="/V1/tmdt-search/products" method="GET">
        <service class="Tmdt\Search\Api\ProductSearchInterface" method="search" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
