<script>
(function () {
    'use strict';

    // ==== CONFIG ====
    var CHATBOT_API = '/rest/V1/chatbot/ask';
    var isOpen      = false;
    var isLoading   = false;

    // ==== TOGGLE ====
    window.tmdtCbToggle = function () {
        isOpen = !isOpen;
        var win     = document.getElementById('tmdt-cb-window');
        var trigger = document.getElementById('tmdt-cb-trigger');
        win.classList.toggle('is-visible', isOpen);
        trigger.classList.toggle('is-open', isOpen);
        if (isOpen) {
            setTimeout(function () {
                document.getElementById('tmdt-cb-input').focus();
            }, 300);
        }
    };

    // ==== KEYBOARD ====
    window.tmdtCbHandleKey = function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            tmdtCbSend();
        }
    };

    // ==== SEND ====
    window.tmdtCbSend = function () {
        if (isLoading) return;
        var inputEl = document.getElementById('tmdt-cb-input');
        var text    = (inputEl.value || '').trim();
        if (!text) return;

        tmdtCbAppendMsg('user', tmdtCbEscape(text));
        inputEl.value = '';
        tmdtCbSetLoading(true);

        fetch(CHATBOT_API, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ message: text })
        })
        .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.text();
        })
        .then(function (raw) {
            tmdtCbSetLoading(false);

            // Backend trả JSON object {message, products[]} được Magento double-encode.
            // Cần parse 2 lần: lần 1 ra string, lần 2 ra object.
            var reply    = '';
            var products = [];

            try {
                var firstParse = JSON.parse(raw);
                if (typeof firstParse === 'string') {
                    try {
                        var secondParse = JSON.parse(firstParse);
                        if (secondParse && typeof secondParse === 'object' && 'message' in secondParse) {
                            reply    = secondParse.message || '';
                            products = Array.isArray(secondParse.products) ? secondParse.products : [];
                        } else {
                            reply = firstParse;
                        }
                    } catch (e) {
                        reply = firstParse;
                    }
                } else if (firstParse && typeof firstParse === 'object' && 'message' in firstParse) {
                    reply    = firstParse.message || '';
                    products = Array.isArray(firstParse.products) ? firstParse.products : [];
                } else {
                    reply = String(firstParse);
                }
            } catch (e) {
                reply = raw;
            }

            tmdtCbAppendMsg('bot', tmdtCbRenderMarkdown(reply));

            if (products.length > 0) {
                tmdtCbAppendProductCards(products);
            }
        })
        .catch(function (err) {
            tmdtCbSetLoading(false);
            tmdtCbAppendMsg('bot', '⚠️ Không thể kết nối máy chủ. Vui lòng thử lại sau.');
            console.error('[TMDT Chatbot]', err);
        });
    };

    // ==== APPEND PRODUCT CARDS ====
    function tmdtCbAppendProductCards(products) {
        var container = document.getElementById('tmdt-cb-messages');

        // Nhãn "Sản phẩm liên quan:"
        var label       = document.createElement('div');
        label.className = 'tmdt-cb-msg bot';
        label.style.cssText = 'background:transparent;box-shadow:none;padding:4px 0 2px 2px;font-size:12px;color:#9ca3af;';
        label.textContent   = 'Sản phẩm liên quan:';
        container.appendChild(label);

        products.forEach(function (p) {
            var a       = document.createElement('a');
            a.className = 'tmdt-cb-product';
            a.href      = p.url || '#';
            a.target    = '_blank';
            a.rel       = 'noopener noreferrer';

            // Ảnh hoặc placeholder
            var imgHtml = '';
            if (p.image) {
                imgHtml = '<img class="tmdt-cb-product-img" src="' + tmdtCbEscape(p.image)
                    + '" alt="' + tmdtCbEscape(p.name)
                    + '" onerror="this.style.display=\'none\'">';
            } else {
                imgHtml = '<div class="tmdt-cb-product-img" style="display:flex;align-items:center;justify-content:center;font-size:24px;background:#f0f2ff;">🛍️</div>';
            }

            a.innerHTML = imgHtml
                + '<div class="tmdt-cb-product-info">'
                + '<div class="tmdt-cb-product-name">' + tmdtCbEscape(p.name || '') + '</div>'
                + '<div class="tmdt-cb-product-price">' + tmdtCbEscape(p.price || '') + '</div>'
                + '<div class="tmdt-cb-product-cta">Xem sản phẩm →</div>'
                + '</div>';

            container.appendChild(a);
        });

        tmdtCbScrollBottom(container);
    }

    // ==== APPEND MESSAGE ====
    function tmdtCbAppendMsg(sender, htmlContent) {
        var container = document.getElementById('tmdt-cb-messages');
        var div       = document.createElement('div');
        div.className = 'tmdt-cb-msg ' + sender;
        div.innerHTML = htmlContent;
        container.appendChild(div);
        tmdtCbScrollBottom(container);
        return div;
    }

    // ==== LOADING (typing indicator) ====
    var typingEl = null;
    function tmdtCbSetLoading(state) {
        isLoading = state;
        var sendBtn   = document.getElementById('tmdt-cb-send');
        sendBtn.disabled = state;

        if (state) {
            var container = document.getElementById('tmdt-cb-messages');
            typingEl = document.createElement('div');
            typingEl.className = 'tmdt-cb-typing';
            typingEl.innerHTML = '<span></span><span></span><span></span>';
            container.appendChild(typingEl);
            tmdtCbScrollBottom(container);
        } else {
            if (typingEl && typingEl.parentNode) {
                typingEl.parentNode.removeChild(typingEl);
            }
            typingEl = null;
        }
    }

    // ==== RENDER MARKDOWN đơn giản ====
    function tmdtCbRenderMarkdown(text) {
        if (!text) return '';
        // Xử lý link dạng http://... . html
        text = text.replace(
            /(https?:\/\/[^\s<>"]+)/g,
            '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
        );
        // **in đậm**
        text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        // *in nghiêng*
        text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        // Xuống dòng
        text = text.replace(/\n/g, '<br>');
        // Gạch đầu dòng
        text = text.replace(/<br>-\s+/g, '<br>• ');
        return text;
    }

    // ==== ESCAPE HTML ====
    function tmdtCbEscape(str) {
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ==== SCROLL ====
    function tmdtCbScrollBottom(el) {
        setTimeout(function () {
            el.scrollTop = el.scrollHeight;
        }, 50);
    }

})();
</script>
