<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tmdt-registration/login" method="POST">
        <service class="Tmdt\Registration\Api\LoginInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/google-login" method="POST">
        <service class="Tmdt\Registration\Api\GoogleLoginInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/register" method="POST">
        <service class="Tmdt\Registration\Api\RegisterInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/forgot-password/request-otp" method="POST">
        <service class="Tmdt\Registration\Api\ForgotPasswordRequestOtpInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/forgot-password/reset" method="POST">
        <service class="Tmdt\Registration\Api\ForgotPasswordResetInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/profile" method="PUT">
        <service class="Tmdt\Registration\Api\ProfileUpdateInterface" method="save" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/profile" method="GET">
        <service class="Tmdt\Registration\Api\ProfileViewInterface" method="get" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/addusers" method="POST">
        <service class="Tmdt\Registration\Api\AddUsersInterface" method="save" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/branch-managers" method="GET">
        <service class="Tmdt\Registration\Api\BranchManagerListInterface" method="get" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/branch-managers/:managerId" method="PUT">
        <service class="Tmdt\Registration\Api\BranchManagerUpdateInterface" method="update" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
    <route url="/V1/tmdt-registration/branch-managers/:managerId" method="DELETE">
        <service class="Tmdt\Registration\Api\BranchManagerDeleteInterface" method="delete" />
        <resources>
            <resource ref="self" />
        </resources>
    </route>
</routes>