<?php
/** @var \Tmdt\Registration\Block\Adminhtml\Registration $block */
$rows = $block->getRows();
$pendingCount = 0;
$approvedCount = 0;
$rejectedCount = 0;
foreach ($rows as $row) {
    $status = strtolower((string) ($row['status'] ?? ''));
    if ($status === 'pending') {
        $pendingCount++;
    } elseif ($status === 'approved') {
        $approvedCount++;
    } elseif ($status === 'rejected') {
        $rejectedCount++;
    }
}
