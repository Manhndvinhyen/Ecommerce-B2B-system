            onkeydown="tmdtCbHandleKey(event)"
            autocomplete="off"
            aria-label="Nhập tin nhắn"
        />
        <button id="tmdt-cb-send" onclick="tmdtCbSend()" aria-label="Gửi tin nhắn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
        </button>
