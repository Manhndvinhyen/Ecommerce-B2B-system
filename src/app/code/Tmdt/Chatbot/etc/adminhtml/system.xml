<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="tmdt" translate="label" sortOrder="300">
            <label>TMDT</label>
        </tab>
        <section id="tmdt_chatbot" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Chatbot</label>
            <tab>tmdt</tab>
            <resource>Magento_Config::config</resource>
            <group id="deepseek" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>DeepSeek</label>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>DeepSeek API key used by the product recommendation chatbot.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
