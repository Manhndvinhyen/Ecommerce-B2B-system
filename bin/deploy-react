#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT_DIR="$PROJECT_ROOT"
REACT_DIR="$PROJECT_ROOT/src/react-frontend"
CUSTOM_ENV_FILE="$PROJECT_ROOT/env/custom.env"
LIVE_DOMAIN="${LIVE_DOMAIN:-https://organica.click}"
SKIP_LIVE_CHECK="${SKIP_LIVE_CHECK:-0}"

echo "🚀 Bắt đầu build React App..."

echo "📦 Cài đặt thư viện NPM trong Docker..."
if [ -f "$REACT_DIR/package-lock.json" ]; then
  "$PROJECT_ROOT/bin/cli" sh -c "cd react-frontend && npm ci --no-audit --no-fund"
else
  "$PROJECT_ROOT/bin/cli" sh -c "cd react-frontend && npm install --no-audit --no-fund"
fi

HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

if [[ -x "$PROJECT_ROOT/bin/root" ]]; then
  echo "🔧 Đồng bộ quyền ghi thư mục src/pub/react..."
  (
    cd "$PROJECT_ROOT"
    bin/root sh -lc "mkdir -p /var/www/html/pub/react && chown -R ${HOST_UID}:${HOST_GID} /var/www/html/pub/react"
  ) || true
fi

if [ ! -f "$REACT_DIR/.env" ]; then
    echo "⚠️ Không tìm thấy file .env, đang tự động tạo từ .env.example..."
    cp "$REACT_DIR/.env.example" "$REACT_DIR/.env"
fi

echo "🛠️ Build ứng dụng React trong Docker..."
"$PROJECT_ROOT/bin/cli" sh -c "cd react-frontend && npm run build"

echo "🔁 Đồng bộ build vào Magento theme (react-home) trong Docker..."
"$PROJECT_ROOT/bin/cli" sh -c "cd react-frontend && node scripts/magento-sync.mjs"

LOCAL_SCRIPT=$(sed -n 's/.*src="\(\/react\/assets\/index-[^"]*\.js\)".*/\1/p' "$PROJECT_ROOT/src/pub/react/index.html" | head -1)
echo "   - Local bundle: ${LOCAL_SCRIPT:-N/A}"

echo "🔄 Reload nginx..."
cd "$PROJECT_ROOT"
NGINX_CONTAINER=$(docker ps --filter "label=com.docker.compose.service=app" --format "{{.ID}}" | head -1)
if [ -n "$NGINX_CONTAINER" ]; then
  docker exec "$NGINX_CONTAINER" nginx -s reload
else
  echo "⚠️ Không clear được cache qua ./bin/magento (kiểm tra Docker service)."
fi

echo "🔄 Reload nginx trong container (nếu có)..."
if command -v docker >/dev/null 2>&1; then
  NGINX_CONTAINER=$(docker ps --filter "label=com.docker.compose.service=app" --format "{{.ID}}" | head -1 || true)
  if [ -n "${NGINX_CONTAINER:-}" ]; then
    docker exec "$NGINX_CONTAINER" nginx -s reload || true
  else
    echo "⚠️ Không tìm thấy container service=app để reload nginx."
  fi
fi

if [[ "$SKIP_LIVE_CHECK" == "1" ]]; then
  echo "⏭️  Bo qua kiem tra live (SKIP_LIVE_CHECK=1)"
else
  echo "🔎 Verify nhanh trạng thái live: $LIVE_DOMAIN"
  if command -v curl >/dev/null 2>&1; then
    LIVE_SCRIPT=$(curl -L -s "$LIVE_DOMAIN/" 2>/dev/null | sed -n 's/.*src="\(\/react\/assets\/index-[^"]*\.js\)".*/\1/p' | head -1)
    echo "   - Live bundle: ${LIVE_SCRIPT:-N/A}"

    if curl -L -s "$LIVE_DOMAIN/checkout/cart" | grep -q "view=cart"; then
      echo "   - Cart route override: OK (/checkout/cart -> /react/index.html?view=cart)"
    else
      echo "   - Cart route override: CHUA THAY"
    fi

    if [ -n "${LOCAL_SCRIPT:-}" ] && [ -n "${LIVE_SCRIPT:-}" ] && [ "$LOCAL_SCRIPT" != "$LIVE_SCRIPT" ]; then
      echo "❌ Live van dang dung bundle cu."
      echo "   Local: $LOCAL_SCRIPT"
      echo "   Live : $LIVE_SCRIPT"
      echo "   -> Hay deploy tren dung production server hoac purge CDN (Cloudflare) cho /react/*"
      exit 2
    fi
  fi
fi

echo "✅ Hoàn tất deploy React cho $LIVE_DOMAIN"
