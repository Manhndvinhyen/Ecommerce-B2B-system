<?xml version="1.0" encoding="utf-8"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/db_schema.xsd">
    <table name="tmdt_orders" resource="default" engine="innodb" comment="Tmdt B2B Orders">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Order ID"/>
        <column xsi:type="varchar" name="order_code" length="32" nullable="false" comment="Order Code e.g. DH-100293"/>
        <column xsi:type="varchar" name="parent_code" length="32" nullable="true" comment="Parent Order Code for Splitting"/>
        <column xsi:type="int" name="parent_id" padding="10" unsigned="true" nullable="true" comment="Parent Order ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="pending" comment="pending|waiting_payment|paid|processing|shipping|delivered|completed|cancelled|refunded|expired"/>
        <column xsi:type="decimal" name="total_amount" scale="2" precision="14" nullable="false" comment="Total Amount VND"/>
        <column xsi:type="text" name="items_json" nullable="true" comment="Cart items JSON (legacy support)"/>
        <column xsi:type="varchar" name="customer_email" length="255" nullable="true" comment="Customer Email"/>
        <column xsi:type="varchar" name="customer_name" length="255" nullable="true" comment="Customer Name"/>
        <column xsi:type="text" name="shipping_json" nullable="true" comment="Shipping Info JSON"/>
        <column xsi:type="varchar" name="transaction_id" length="128" nullable="true" comment="Bank Transaction ID"/>
        <column xsi:type="timestamp" name="expires_at" on_update="false" nullable="true" comment="Order Expiry Time (15 min hold)"/>
        <column xsi:type="timestamp" name="paid_at" on_update="false" nullable="true" comment="Payment Confirmed Time"/>
        <column xsi:type="varchar" name="payment_method" length="64" nullable="true" comment="Payment Method e.g. bank_transfer, direct_payment"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TMDT_ORDERS_ORDER_CODE">
            <column name="order_code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDERS_PARENT_ID_TMDT_ORDERS_ID" table="tmdt_orders" column="parent_id" referenceTable="tmdt_orders" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDERS_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_orders" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="TMDT_ORDERS_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="tmdt_order_items" resource="default" engine="innodb" comment="Tmdt Order Line Items">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Order ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Product Name"/>
        <column xsi:type="varchar" name="unit" length="32" nullable="true" default="kg" comment="Sales Unit"/>
        <column xsi:type="decimal" name="quantity" scale="4" precision="12" nullable="false" comment="Quantity"/>
        <column xsi:type="decimal" name="unit_price" scale="2" precision="12" nullable="false" comment="Unit Price"/>
        <column xsi:type="decimal" name="row_total" scale="2" precision="14" nullable="false" comment="Row Total"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="true" comment="Seller Customer ID"/>
        <column xsi:type="varchar" name="image" length="255" nullable="true" comment="Product Image URL"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDER_ITEMS_ORDER_ID_TMDT_ORDERS_ID" table="tmdt_order_items" column="order_id" referenceTable="tmdt_orders" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDER_ITEMS_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID" table="tmdt_order_items" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDER_ITEMS_SELLER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_order_items" column="seller_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
    </table>

    <table name="tmdt_order_status_history" resource="default" engine="innodb" comment="Tmdt Order Status History">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="History ID"/>
        <column xsi:type="varchar" name="order_code" length="32" nullable="false" comment="Order Code (legacy support)"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="Order ID"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" comment="Status"/>
        <column xsi:type="text" name="comment" nullable="true" comment="Comment"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_ORDER_STATUS_HISTORY_ORDER_ID_TMDT_ORDERS_ID" table="tmdt_order_status_history" column="order_id" referenceTable="tmdt_orders" referenceColumn="id" onDelete="CASCADE"/>
    </table>

    <table name="tmdt_seller_notifications" resource="default" engine="innodb" comment="Tmdt Seller Notifications">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Notification ID"/>
        <column xsi:type="varchar" name="seller_id" length="32" nullable="false" comment="Seller Customer ID (legacy support)"/>
        <column xsi:type="int" name="seller_customer_id" padding="10" unsigned="true" nullable="true" comment="Seller Customer ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU or Order Code"/>
        <column xsi:type="text" name="message" nullable="false" comment="Alert Message"/>
        <column xsi:type="smallint" name="is_read" padding="5" unsigned="true" nullable="false" default="0" comment="Read status: 0=unread, 1=read"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_SELLER_NOTIFICATIONS_SELLER_CUSTOMER_ID_CUSTOMER_ENTITY_ENT" table="tmdt_seller_notifications" column="seller_customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="tmdt_transactions" resource="default" engine="innodb" comment="Tmdt Revenue/Payment Transactions">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Transaction ID"/>
        <column xsi:type="varchar" name="order_code" length="32" nullable="false" comment="Order Code (legacy support)"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="Order ID"/>
        <column xsi:type="varchar" name="transaction_id" length="128" nullable="false" comment="Payment Gateway Transaction ID"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="14" nullable="false" comment="Transaction Amount"/>
        <column xsi:type="varchar" name="seller_id" length="32" nullable="true" comment="Seller Customer ID (legacy support)"/>
        <column xsi:type="int" name="seller_customer_id" padding="10" unsigned="true" nullable="true" comment="Seller Customer ID"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="success" comment="Transaction status: pending, success, failed, refunded"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_TRANSACTIONS_ORDER_ID_TMDT_ORDERS_ID" table="tmdt_transactions" column="order_id" referenceTable="tmdt_orders" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_TRANSACTIONS_SELLER_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_transactions" column="seller_customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
    </table>

    <table name="tmdt_inventory_log" resource="default" engine="innodb" comment="Tmdt Inventory Adjustment Logs">
        <column xsi:type="int" name="log_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="true" comment="Product ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="varchar" name="action_type" length="32" nullable="false" comment="Action Type: inbound, outbound, system_adjust"/>
        <column xsi:type="decimal" name="qty_change" scale="4" precision="12" nullable="false" comment="Quantity Change"/>
        <column xsi:type="decimal" name="qty_after" scale="4" precision="12" nullable="false" comment="Quantity After Adjustment"/>
        <column xsi:type="varchar" name="reference_type" length="32" nullable="true" comment="Reference Type: order, refund, manual"/>
        <column xsi:type="varchar" name="reference_id" length="64" nullable="true" comment="Reference ID"/>
        <column xsi:type="text" name="note" nullable="true" comment="Adjustment Note"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Log Creation Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_INVENTORY_LOG_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID" table="tmdt_inventory_log" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="TMDT_INVENTORY_LOG_SKU" indexType="btree">
            <column name="sku"/>
        </index>
    </table>

    <table name="tmdt_rfq_request" resource="default" engine="innodb" comment="Tmdt RFQ Requests">
        <column xsi:type="int" name="request_id" padding="10" unsigned="true" nullable="false" identity="true" comment="RFQ Request ID"/>
        <column xsi:type="int" name="buyer_id" padding="10" unsigned="true" nullable="false" comment="Buyer Customer ID"/>
        <column xsi:type="varchar" name="buyer_name" length="255" nullable="true" comment="Buyer Name"/>
        <column xsi:type="varchar" name="buyer_email" length="255" nullable="true" comment="Buyer Email"/>
        <column xsi:type="varchar" name="product_name" length="255" nullable="false" comment="Requested Product Name"/>
        <column xsi:type="varchar" name="category" length="128" nullable="true" comment="Requested Category"/>
        <column xsi:type="decimal" name="quantity" scale="4" precision="12" nullable="false" default="1.0000" comment="Requested Quantity"/>
        <column xsi:type="varchar" name="unit" length="32" nullable="true" comment="Unit"/>
        <column xsi:type="varchar" name="delivery_region" length="255" nullable="true" comment="Delivery Region"/>
        <column xsi:type="date" name="needed_by" nullable="true" comment="Needed By Date"/>
        <column xsi:type="decimal" name="target_price" scale="2" precision="14" nullable="true" comment="Target Price"/>
        <column xsi:type="text" name="description" nullable="true" comment="Buyer Requirement Description"/>
        <column xsi:type="text" name="image_url" nullable="true" comment="Reference Image URL"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="open" comment="open|quoted|closed|cancelled"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="request_id"/>
        </constraint>
        <index referenceId="TMDT_RFQ_REQUEST_BUYER_ID" indexType="btree">
            <column name="buyer_id"/>
        </index>
        <index referenceId="TMDT_RFQ_REQUEST_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="tmdt_rfq_quote" resource="default" engine="innodb" comment="Tmdt RFQ Seller Quotes">
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" identity="true" comment="RFQ Quote ID"/>
        <column xsi:type="int" name="request_id" padding="10" unsigned="true" nullable="false" comment="RFQ Request ID"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="false" comment="Seller Customer ID"/>
        <column xsi:type="varchar" name="seller_name" length="255" nullable="true" comment="Seller Name"/>
        <column xsi:type="decimal" name="unit_price" scale="2" precision="14" nullable="false" comment="Quoted Unit Price"/>
        <column xsi:type="decimal" name="available_quantity" scale="4" precision="12" nullable="true" comment="Available Quantity"/>
        <column xsi:type="varchar" name="delivery_time" length="128" nullable="true" comment="Delivery Time"/>
        <column xsi:type="varchar" name="quality_grade" length="128" nullable="true" comment="Quality Grade"/>
        <column xsi:type="text" name="description" nullable="true" comment="Seller Quote Description"/>
        <column xsi:type="text" name="image_url" nullable="true" comment="Seller Product Image URL"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="submitted" comment="submitted|accepted|rejected"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <index referenceId="TMDT_RFQ_QUOTE_REQUEST_ID" indexType="btree">
            <column name="request_id"/>
        </index>
        <index referenceId="TMDT_RFQ_QUOTE_SELLER_ID" indexType="btree">
            <column name="seller_id"/>
        </index>
    </table>

    <table name="tmdt_recurring_schedules" resource="default" engine="innodb" comment="Tmdt Recurring Order Subscriptions">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Subscription ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_email" length="255" nullable="false" comment="Customer Email"/>
        <column xsi:type="varchar" name="customer_name" length="255" nullable="false" comment="Customer Name"/>
        <column xsi:type="varchar" name="frequency" length="32" nullable="false" comment="weekly|monthly"/>
        <column xsi:type="varchar" name="weekdays" length="64" nullable="true" comment="Comma-separated weekdays 0-6"/>
        <column xsi:type="int" name="month_day" padding="5" nullable="true" comment="Day of month 1-31"/>
        <column xsi:type="varchar" name="delivery_time" length="32" nullable="false" comment="Delivery Time Slot"/>
        <column xsi:type="text" name="items_json" nullable="false" comment="Cart Items JSON (legacy support)"/>
        <column xsi:type="text" name="shipping_json" nullable="false" comment="Shipping Info JSON"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="active" comment="active|cancelled"/>
        <column xsi:type="date" name="last_run_date" nullable="true" comment="Last Run Date"/>
        <column xsi:type="date" name="next_run_date" nullable="false" comment="Next Run Date"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_SCHEDULES_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_I" table="tmdt_recurring_schedules" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="TMDT_RECURRING_SCHEDULES_EMAIL" indexType="btree">
            <column name="customer_email"/>
        </index>
        <index referenceId="TMDT_RECURRING_SCHEDULES_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="tmdt_recurring_items" resource="default" engine="innodb" comment="Tmdt Recurring Order Items">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="schedule_id" padding="10" unsigned="true" nullable="false" comment="Schedule ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Product Name"/>
        <column xsi:type="varchar" name="unit" length="32" nullable="true" default="kg" comment="Sales Unit"/>
        <column xsi:type="decimal" name="quantity" scale="4" precision="12" nullable="false" comment="Quantity"/>
        <column xsi:type="decimal" name="unit_price" scale="2" precision="12" nullable="false" comment="Unit Price"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="true" comment="Seller Customer ID"/>
        <column xsi:type="varchar" name="supplier_name" length="255" nullable="true" comment="Supplier Name"/>
        <column xsi:type="varchar" name="supplier_region" length="128" nullable="true" comment="Supplier Region"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_ITEMS_SCHEDULE_ID_TMDT_RECURRING_SCHEDULES_ID" table="tmdt_recurring_items" column="schedule_id" referenceTable="tmdt_recurring_schedules" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_ITEMS_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_I" table="tmdt_recurring_items" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_ITEMS_SELLER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_recurring_items" column="seller_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
    </table>

    <table name="tmdt_recurring_runs" resource="default" engine="innodb" comment="Tmdt Recurring Schedule Audit Logs">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Run ID"/>
        <column xsi:type="int" name="schedule_id" padding="10" unsigned="true" nullable="false" comment="Schedule ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="Order ID"/>
        <column xsi:type="date" name="run_date" nullable="false" comment="Run Date"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" comment="Run status: success, failed"/>
        <column xsi:type="text" name="message" nullable="true" comment="Output message"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_RUNS_SCHEDULE_ID_TMDT_RECURRING_SCHEDULES_ID" table="tmdt_recurring_runs" column="schedule_id" referenceTable="tmdt_recurring_schedules" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TMDT_RECURRING_RUNS_ORDER_ID_TMDT_ORDERS_ID" table="tmdt_recurring_runs" column="order_id" referenceTable="tmdt_orders" referenceColumn="id" onDelete="SET NULL"/>
    </table>

    <table name="tmdt_seller_balance" resource="default" engine="innodb" comment="Tmdt Seller Balances">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Balance ID"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="false" comment="Seller Customer ID"/>
        <column xsi:type="decimal" name="available_balance" scale="2" precision="14" nullable="false" default="0.00" comment="Available Balance"/>
        <column xsi:type="decimal" name="pending_balance" scale="2" precision="14" nullable="false" default="0.00" comment="Pending Balance"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TMDT_SELLER_BALANCE_SELLER_ID">
            <column name="seller_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_SELLER_BALANCE_SELLER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_seller_balance" column="seller_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="tmdt_payouts" resource="default" engine="innodb" comment="Tmdt Seller Payout Records">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Payout ID"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="false" comment="Seller Customer ID"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="14" nullable="false" comment="Amount VND"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" comment="pending|success|failed|cancelled"/>
        <column xsi:type="timestamp" name="requested_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Requested At"/>
        <column xsi:type="timestamp" name="paid_at" on_update="false" nullable="true" comment="Paid At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TMDT_PAYOUTS_SELLER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="tmdt_payouts" column="seller_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="tmdt_promotions" resource="default" engine="innodb" comment="Tmdt Promotions and Banners">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="title" length="255" nullable="false" comment="Title"/>
        <column xsi:type="text" name="description" nullable="false" comment="Description"/>
        <column xsi:type="varchar" name="image" length="255" nullable="false" comment="Image Path/URL"/>
        <column xsi:type="varchar" name="button_text" length="64" nullable="false" comment="Button Text"/>
        <column xsi:type="varchar" name="button_action" length="255" nullable="false" comment="Button Action"/>
        <column xsi:type="varchar" name="type" length="32" nullable="false" comment="Type: banner, voucher, seasonal"/>
        <column xsi:type="varchar" name="discount_code" length="32" nullable="true" comment="Discount Code"/>
