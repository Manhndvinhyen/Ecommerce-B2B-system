#!/usr/bin/env bash
# bin/deploy-prod — Production deployment script
# Run on GCP VM after every git pull to update the live site
#
# Usage:
#   bin/deploy-prod              → pull from current branch
#   bin/deploy-prod main         → pull from specific branch

set -o errexit

BRANCH="${1:-$(git rev-parse --abbrev-ref HEAD)}"

echo "========================================"
echo " Production Deployment"
echo " Branch: $BRANCH"
echo "========================================"

echo ""
echo "📥 Pulling latest code from $BRANCH..."
git fetch origin "$BRANCH"
git reset --hard "origin/$BRANCH"

echo ""
echo "🔑 Fixing file permissions..."
mkdir -p src/var src/generated src/pub/static src/pub/media/tmdt_registration/licenses
bin/docker-compose --prod exec -T -u root phpfpm sh -c "mkdir -p /var/www/html/var /var/www/html/generated /var/www/html/pub/static /var/www/html/pub/media/tmdt_registration/licenses && chown -R app:app /var/www/html/var /var/www/html/generated /var/www/html/pub/static /var/www/html/pub/media /var/www/html/app/etc && chmod -R u+rwX,g+rwX /var/www/html/var /var/www/html/generated /var/www/html/pub/static /var/www/html/pub/media /var/www/html/app/etc" || true

echo ""
echo "⚙️  Running Magento setup:upgrade..."
bin/docker-compose --prod exec -T phpfpm bin/magento setup:upgrade --no-interaction

echo ""
echo "🗑️  Flushing cache..."
bin/docker-compose --prod exec -T phpfpm bin/magento cache:flush

echo ""
echo "🔨 Building React frontend..."
bin/deploy-react

echo ""
echo "Deploying Magento static content for admin/storefront locales..."
bin/docker-compose --prod exec -T phpfpm bin/magento setup:static-content:deploy vi_VN en_US -f

echo ""
echo "Flushing cache after static content deployment..."
bin/docker-compose --prod exec -T phpfpm bin/magento cache:flush

echo ""
echo "Re-applying writable directory permissions..."
bin/docker-compose --prod exec -T -u root phpfpm sh -c "mkdir -p /var/www/html/pub/media/tmdt_registration/licenses && chown -R app:app /var/www/html/var /var/www/html/generated /var/www/html/pub/static /var/www/html/pub/media /var/www/html/app/etc && chmod -R u+rwX,g+rwX /var/www/html/var /var/www/html/generated /var/www/html/pub/static /var/www/html/pub/media /var/www/html/app/etc" || true

echo ""
echo "========================================"
echo "✅ Deployment complete!"
echo "========================================"
