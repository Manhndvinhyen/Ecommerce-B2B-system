<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Product Management Routes -->
    <route url="/V1/tmdt-catalog/product" method="POST">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="createProduct"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/product/:sku" method="PUT">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="updateProduct"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/product/:sku" method="DELETE">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="deleteProduct"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/products" method="GET">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="getSellerProducts"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <!-- Inventory Management Routes -->
    <route url="/V1/tmdt-catalog/inventory/adjust" method="POST">
        <service class="Tmdt\Catalog\Api\InventoryManagementInterface" method="adjustStock"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/inventory/logs" method="GET">
        <service class="Tmdt\Catalog\Api\InventoryManagementInterface" method="getAdjustmentLogs"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <!-- Order Management Routes -->
    <route url="/V1/tmdt-orders/create" method="POST">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="createOrder"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-orders/status/:orderCode" method="GET">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="getOrderStatus"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-orders/warehouses" method="GET">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="getWarehouses"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <!-- Seller Stock Warning Notifications -->
    <route url="/V1/tmdt-catalog/notifications" method="GET">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="getSellerNotifications"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/notifications/read" method="POST">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="markNotificationsAsRead"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <!-- Seller Revenue and Analytics Stats -->
    <route url="/V1/tmdt-catalog/revenue" method="GET">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="getSellerRevenueStats"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/orders" method="GET">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="getSellerOrders"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <!-- Currency Rates REST API -->
    <route url="/V1/tmdt-catalog/rates" method="GET">
        <service class="Tmdt\Catalog\Api\RatesInterface" method="getRates"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <!-- Recurring Orders / Subscriptions REST API -->
    <route url="/V1/tmdt-recurring/subscribe" method="POST">
        <service class="Tmdt\Catalog\Api\RecurringInterface" method="subscribe"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-recurring/list" method="GET">
        <service class="Tmdt\Catalog\Api\RecurringInterface" method="listSubscriptions"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-recurring/cancel" method="POST">
        <service class="Tmdt\Catalog\Api\RecurringInterface" method="cancelSubscription"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/promotions" method="GET">
        <service class="Tmdt\Catalog\Api\PromotionManagementInterface" method="getPromotions"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/tmdt-catalog/suppliers" method="GET">
        <service class="Tmdt\Catalog\Api\PromotionManagementInterface" method="getSuppliers"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <!-- COD payment confirmation REST route for authenticated B2B sellers -->
    <route url="/V1/tmdt-orders/confirm-payment" method="POST">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="confirmDirectPayment"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <!-- Order fulfillment update REST route for authenticated B2B sellers -->
    <route url="/V1/tmdt-orders/update-fulfillment" method="POST">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="updateOrderFulfillment"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <!-- Customer order receipt confirmation REST route -->
    <route url="/V1/tmdt-orders/confirm-receipt" method="POST">
        <service class="Tmdt\Catalog\Api\OrderManagementInterface" method="confirmReceiptByCustomer"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <!-- Customer purchase history - authenticated customer token required -->
    <route url="/V1/tmdt-search/purchase-history" method="GET">
        <service class="Tmdt\Catalog\Api\ProductManagementInterface" method="getPurchaseHistory"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <!-- Request For Quotation (RFQ) System Routes -->
    <route url="/V1/tmdt-rfq/create" method="POST">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="createRfq"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/buyer-list" method="GET">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="getBuyerRfqs"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/open-list" method="GET">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="getOpenRfqs"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/quote/submit" method="POST">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="submitQuote"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/quotes/:rfqId" method="GET">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="getQuotesForRfq"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/seller-quotes" method="GET">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="getSellerQuotes"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/quote/accept" method="POST">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="acceptQuote"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/message/add" method="POST">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="addRfqMessage"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/tmdt-rfq/messages/:rfqId" method="GET">
        <service class="Tmdt\Catalog\Api\RfqManagementInterface" method="getRfqMessages"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <!-- NOTE: Webhook is handled by Controller at /tmdt/webhook/sepay (not REST API) -->
</routes>
