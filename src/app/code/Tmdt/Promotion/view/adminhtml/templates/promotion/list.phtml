<?php
/** @var \Tmdt\Catalog\Block\Adminhtml\Promotion $block */
$saveUrl = $block->getSaveUrl();
$autoPromotions = $block->getRows('auto_discount');
$vouchers = $block->getRows('voucher');
$categories = $block->getCategoryOptions();
$products = $block->getProductOptions();

$renderCategoryOptions = static function ($block, array $categories, $selected = ''): void {
    foreach ($categories as $category) {
        $id = (string)$category['id'];
        $label = str_repeat('-- ', max(0, (int)$category['level'] - 2)) . (string)$category['name'];
        $isSelected = $block->isSelectedListValue($selected, $id) ? ' selected' : '';
        echo '<option value="' . (int)$category['id'] . '"' . $isSelected . '>' . $block->escapeHtml($label) . '</option>';
    }
};
